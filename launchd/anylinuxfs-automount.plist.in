<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: install.sh replaces the @PLACEHOLDERS@ and installs it to /Library/LaunchDaemons/ -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@LABEL@</string>
    <key>ProgramArguments</key>
    <array>
        <string>@LAUNCHER@</string>
    </array>
    <key>StartInterval</key>
    <integer>5</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@ANYLINUXFS_DIR@:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>ANYLINUXFS</key>
        <string>@ANYLINUXFS@</string>
        <!-- anylinuxfs uses these to find the user's VM image and configuration -->
        <key>HOME</key>
        <string>@HOME@</string>
        <key>SUDO_USER</key>
        <string>@USER@</string>
        <key>SUDO_UID</key>
        <string>@UID@</string>
        <key>SUDO_GID</key>
        <string>@GID@</string>
    </dict>
    <key>StandardOutPath</key>
    <string>@LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
</dict>
</plist>
